# Copy this file to .env and replace every CHANGE_ME value before starting.
UPDATE_MONITOR_USERNAME=CHANGE_ME_USERNAME
UPDATE_MONITOR_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARACTERS
UPDATE_MONITOR_SESSION_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Set true only when Update Monitor is served through HTTPS.
UPDATE_MONITOR_SESSION_HTTPS_ONLY=false

# Run an initial Docker scan after startup.
UPDATE_MONITOR_SCAN_ON_START=true

# Optional: GitHub token for higher API limits. Leave empty when not used.
UPDATE_MONITOR_GITHUB_TOKEN=
